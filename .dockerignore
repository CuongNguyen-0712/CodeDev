# Build context of codedev_app (./Dockerfile). The sandbox image builds from ./sandbox.

# dependencies and build output (rebuilt inside the image)
node_modules
.next
out
coverage

# secrets and local configuration: never sent to the Docker daemon
.env*
*.pem

# version control, editors, agents
.git
.gitignore
.vscode
.claude
.agents
*.stackdump
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store

# not part of the app runtime
sandbox
content
scripts
docs
__tests__
tests
db/backups
db/seeds
design.pen
compose.yml
Dockerfile
*.md
