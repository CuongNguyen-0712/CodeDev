Table catalog.career_role {
  id int [pk, increment]
  code varchar(50) [not null, unique]
  name varchar(100) [not null]
  description text
  sort_order int [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz

  Note: '''
  Career roles a learner picks during onboarding (not RBAC roles: see identity.roles)
  chk_career_role_code: CHECK (((code)::text ~ '^[a-z0-9_]+$'::text))
  '''
}

Table catalog.career_role_skill {
  career_role_id int
  skill_id int
  weight smallint [not null, default: 1]

  indexes {
    (career_role_id, skill_id) [pk]
    skill_id [name: 'idx_career_role_skill_skill']
  }

  Note: '''
  chk_career_role_skill_weight: CHECK (((weight >= 1) AND (weight <= 5)))
  '''
}

Table catalog.category {
  id int [pk, increment]
  name varchar(255) [not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp
}

Table catalog.course {
  title text [not null]
  concept text [not null]
  image text
  rating int
  description text [not null]
  lessons int [not null, default: 0]
  duration int [not null, default: 0]
  instructor text [not null]
  students int [not null, default: 0]
  cost numeric(10,2) [default: 0, note: 'Deprecated: prices live in commerce.offer']
  is_hidden boolean [default: false]
  is_deleted boolean [default: false]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
  modules int [not null, default: 0]
  category_id int
  language_id int
  level public.level_enum
  id bigint [pk, increment]
  public_id varchar(255) [not null, unique]
  point_price bigint [default: 0, note: 'Deprecated: prices live in commerce.offer']
  reward bigint [default: 0]
  reviews bigint [default: 0]
  publish_status varchar(20) [not null, note: 'draft | published | unpublished | archived. Source of truth for visibility; is_hidden is derived from it']
  published_at timestamptz
  course_type varchar(20) [not null, default: 'course']
  access_model varchar(20) [not null, default: 'free', note: 'free: anyone may enrol (a free entitlement is granted). premium: needs an entitlement from a purchase, points or an admin grant']

  indexes {
    title [name: 'course_title']
    category_id [name: 'idx_course_category']
    language_id [name: 'idx_course_language']
    id [name: 'idx_course_listing', note: 'WHERE ((is_hidden = false) AND (is_deleted = false))']
    id [name: 'idx_course_published', note: 'WHERE (((publish_status)::text = \'published\'::text) AND (is_deleted = false))']
  }

  Note: '''
  chk_course_access_model: CHECK (((access_model)::text = ANY ((ARRAY['free'::character varying, 'premium'::character varying])::text[])))
  chk_course_counters: CHECK (((modules >= 0) AND (lessons >= 0) AND (students >= 0) AND (duration >= 0) AND (COALESCE(cost, (0)::numeric) >= (0)::numeric)))
  chk_course_publish_status: CHECK (((publish_status)::text = ANY ((ARRAY['draft'::character varying, 'published'::character varying, 'unpublished'::character varying, 'archived'::character varying])::text[])))
  chk_course_type: CHECK (((course_type)::text = ANY ((ARRAY['course'::character varying, 'project'::character varying, 'workshop'::character varying])::text[])))
  '''
}

Table catalog.course_career_role {
  course_id bigint
  career_role_id int

  indexes {
    (course_id, career_role_id) [pk]
    career_role_id [name: 'idx_course_career_role_role']
  }
}

