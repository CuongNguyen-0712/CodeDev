  "cancelled"
}

Enum public.status_progress_enum {
  "enrolled"
  "in_progress"
  "completed"
}

Enum public.task_priority_enum {
  "high"
  "medium"
  "low"
  "critical"
}

Enum public.task_status_enum {
  "todo"
  "in_progress"
  "cancelled"
  "archived"
