  "beginner"
  "intermediate"
  "advanced"
  "expert"
  "master"
}

Enum public.order_status {
  "pending"
  "completed"
  "cancelled"
  "refunded"
}

Enum public.payment_method {
  "banking"
  "master_card"
}

Enum public.provider_enum {
  "credentials"
  "github"
  "google"
}

Enum public.question_type {
  "single_choice"
  "multiple_choice"
  "text"
  "code"
}

Enum public.status_challenge {
  "coming_soon"
  "closed"
  "open"
}

Enum public.status_course_enum {
  "enrolled"
  "in_progress"
  "paused"
  "completed"
  "cancelled"
}

Enum public.status_friend_request_enum {
  "pending"
  "accepted"
