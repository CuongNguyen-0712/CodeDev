  indexes {
    (course_id, prerequisite_course_id) [pk]
    prerequisite_course_id [name: 'idx_course_prerequisite_prereq']
  }

  Note: '''
  chk_course_prerequisite_not_self: CHECK ((course_id <> prerequisite_course_id))
  '''
}

Table catalog.course_skill {
  course_id bigint
  skill_id int
  weight smallint [not null, default: 1]

  indexes {
    (course_id, skill_id) [pk]
    skill_id [name: 'idx_course_skill_skill']
  }

  Note: '''
  chk_course_skill_weight: CHECK (((weight >= 1) AND (weight <= 5)))
