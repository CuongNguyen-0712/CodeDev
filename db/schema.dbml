Table challenge.challenge_test_cases {
  id bigint [pk, increment]
  challenge_id bigint [not null]
  name varchar(100)
  input_data text
  expected_output text [not null]
  score numeric(8,2) [not null, default: 1]
  is_sample boolean [not null, default: false]
  is_hidden boolean [not null, default: true]
  sort_order int [not null, default: 0]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (challenge_id, sort_order) [name: 'idx_test_cases_challenge']
  }

  Note: '''
  chk_test_case_score: CHECK ((score >= (0)::numeric))
  '''
}

Table challenge.challenges {
  course_id bigint [not null]
  module_id bigint [not null]
  name text [not null]
  title varchar(255) [not null]
  description text
  status public.status_challenge [not null, default: 'coming_soon']
  difficulty public.difficulty_question [not null]
  type varchar(50) [not null]
  is_published boolean [default: false]
  is_deleted boolean [default: false]
  deleted_at timestamp
  created_at timestamp [default: `now()`]
  updated_at timestamp
  id bigint [pk, increment]
  public_id varchar(50) [not null]
  lesson_id bigint [not null]
  points int [default: 0]

  indexes {
    (course_id, module_id) [name: 'idx_challenge_course_module']
    lesson_id [name: 'idx_challenge_lesson']
    public_id [unique, name: 'idx_challenge_public_id']
  }
}

Table challenge.code_run_results {
  run_id bigint [pk]
  stdout text
  stderr text
  exit_code int
  execution_time_ms int
  memory_used_kb bigint
  passed_tests int [not null, default: 0]
  total_tests int [not null, default: 0]
  score numeric(8,2)
  created_at timestamp [not null, default: `now()`]

  Note: '''
  chk_code_run_execution_time: CHECK (((execution_time_ms IS NULL) OR (execution_time_ms >= 0)))
  chk_code_run_memory: CHECK (((memory_used_kb IS NULL) OR (memory_used_kb >= 0)))
  chk_code_run_test_counts: CHECK (((passed_tests >= 0) AND (total_tests >= 0) AND (passed_tests <= total_tests)))
  '''
}

Table challenge.code_run_test_results {
  id bigint [pk, increment]
  run_id bigint [not null]
  test_case_id bigint
  status varchar(30) [not null]
  execution_time_ms int
  score numeric(8,2) [not null, default: 0]

  indexes {
    run_id [name: 'idx_run_test_results_run']
    test_case_id [name: 'idx_run_test_results_test_case']
  }

  Note: '''
  chk_run_test_result_score: CHECK ((score >= (0)::numeric))
  chk_run_test_result_time: CHECK (((execution_time_ms IS NULL) OR (execution_time_ms >= 0)))
  '''
}

Table challenge.code_runs {
  id bigint [pk, increment]
  public_id varchar(50) [not null, unique]
  user_id bigint [not null]
  challenge_id bigint [not null]
  submission_id bigint
  run_type varchar(30) [not null, default: 'manual']
  language varchar(50) [not null]
  source_snapshot jsonb [not null]
  stdin text
  status varchar(30) [not null, default: 'queued']
  queued_at timestamp [not null, default: `now()`]
  started_at timestamp
  finished_at timestamp

  indexes {
    (challenge_id, queued_at) [name: 'idx_code_runs_challenge_created']
    status [name: 'idx_code_runs_status', note: 'WHERE ((status)::text = ANY (ARRAY[(\'queued\'::character varying)::text, (\'running\'::character varying)::text]))']
    submission_id [name: 'idx_code_runs_submission']
    (user_id, queued_at) [name: 'idx_code_runs_user_created']
  }

  Note: '''
  chk_code_run_status: CHECK (((status)::text = ANY (ARRAY[('queued'::character varying)::text, ('running'::character varying)::text, ('completed'::character varying)::text, ('failed'::character varying)::text, ('timeout'::character varying)::text, ('cancelled'::character varying)::text])))
  chk_code_run_type: CHECK (((run_type)::text = ANY (ARRAY[('manual'::character varying)::text, ('submit'::character varying)::text])))
  '''
}

Table challenge.code_submissions {
  id bigint [pk, increment]
  public_id varchar(50) [not null, unique]
  user_id bigint [not null]
  challenge_id bigint [not null]
  language varchar(50) [not null]
  source_snapshot jsonb [not null]
  status varchar(30) [not null, default: 'submitted']
  score numeric(8,2)
  submitted_at timestamp [not null, default: `now()`]

  indexes {
    challenge_id [name: 'idx_code_submissions_challenge']
    (user_id, challenge_id, submitted_at) [name: 'idx_code_submissions_user_challenge']
  }

  Note: '''
  chk_code_submission_score: CHECK (((score IS NULL) OR (score >= (0)::numeric)))
  '''
}

Table challenge.coding_configs {
  challenge_id bigint [pk]
  execution_mode varchar(30) [not null, default: 'function']
  time_limit_ms int [not null, default: 3000]
  memory_limit_mb int [not null, default: 256]
  max_attempts int
  scoring_mode varchar(30) [not null, default: 'test_case']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp

  Note: '''
  chk_coding_configs_max_attempts: CHECK (((max_attempts IS NULL) OR (max_attempts > 0)))
  chk_coding_configs_memory_limit: CHECK ((memory_limit_mb > 0))
  chk_coding_configs_time_limit: CHECK ((time_limit_ms > 0))
  '''
}

Table challenge.coding_files {
  id bigint [pk, increment]
  challenge_id bigint [not null]
  language varchar(50)
  file_path varchar(255) [not null]
  file_role varchar(50) [not null, default: 'starter']
  asset_id bigint
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp

  indexes {
    (challenge_id, language, file_path) [unique, name: 'uq_coding_files_path']
    challenge_id [name: 'idx_coding_files_challenge']
  }
}

Table challenge.coding_workspace_files {
  id bigint [pk, increment]
  workspace_id bigint [not null]
  file_path varchar(255) [not null]
  asset_id bigint [not null]
  version int [not null, default: 1]
  file_size bigint
  created_at timestamp [not null, default: `now()`]

  indexes {
    (workspace_id, file_path) [unique, name: 'uq_workspace_file_path']
    workspace_id [name: 'idx_workspace_files_workspace']
  }

  Note: '''
  chk_workspace_file_size: CHECK (((file_size IS NULL) OR (file_size >= 0)))
  chk_workspace_file_version: CHECK ((version > 0))
  '''
}

Table challenge.coding_workspaces {
  id bigint [pk, increment]
  public_id varchar(50) [not null, unique]
  challenge_id bigint [not null]
  user_id bigint [not null]
  language varchar(50) [not null, default: 'javascript']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp

  indexes {
    (challenge_id, user_id) [unique, name: 'uq_coding_workspace_user_challenge']
    user_id [name: 'idx_coding_workspaces_user']
  }
}

Table challenge.question_options {
  question_id bigint [not null]
  option_text text [not null]
  is_correct boolean [default: false]
  created_at timestamp [default: `now()`]
  updated_at timestamp
  id bigint [pk, increment]

  indexes {
    question_id [name: 'idx_question_options_question']
  }
}

Table challenge.question_submissions {
  user_id bigint [not null]
  question_id bigint [not null]
  question_option_id bigint
  is_correct boolean [not null]
  created_at timestamp [default: `now()`]
  id uuid [pk, default: `gen_random_uuid()`]

  indexes {
    (user_id, question_id) [name: 'idx_question_submissions_user']
  }
}

Table challenge.questions {
  challenge_id bigint [not null]
  question text [not null]
  type public.question_type [not null]
  explanation text
  order_index int
  created_at timestamp [default: `now()`]
  updated_at timestamp
  id bigint [pk, increment]
  points int [default: 10]

  indexes {
    (challenge_id, order_index) [name: 'idx_questions_challenge']
  }
}

Table commerce.cart_items {
  user_id bigint
  course_id bigint
  created_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, course_id) [pk]
  }
}

Table commerce.entitlement {
  id bigint [pk, increment]
  public_id varchar(50) [not null, unique]
  user_id bigint [not null]
  course_id bigint [not null]
  source varchar(20) [not null]
  status varchar(20) [not null, default: 'active']
  order_id bigint
  granted_by bigint
  granted_at timestamptz [not null, default: `now()`]
  expires_at timestamptz
  revoked_at timestamptz
  revoke_reason varchar(50)

  indexes {
    course_id [name: 'idx_entitlement_course']
    (user_id, course_id) [unique, name: 'uq_entitlement_active', note: 'WHERE ((status)::text = \'active\'::text)']
    order_id [unique, name: 'uq_entitlement_order', note: 'WHERE (order_id IS NOT NULL)']
  }

  Note: '''
  Course access. Checked by public.has_course_access for courses, lessons and challenges
  chk_entitlement_order: CHECK ((((source)::text <> ALL ((ARRAY['purchase'::character varying, 'points'::character varying])::text[])) OR (order_id IS NOT NULL)))
  chk_entitlement_revoked: CHECK ((((status)::text <> 'revoked'::text) OR (revoked_at IS NOT NULL)))
  chk_entitlement_source: CHECK (((source)::text = ANY ((ARRAY['free'::character varying, 'purchase'::character varying, 'points'::character varying, 'admin_grant'::character varying, 'subscription'::character varying, 'bundle'::character varying])::text[])))
  chk_entitlement_status: CHECK (((status)::text = ANY ((ARRAY['active'::character varying, 'revoked'::character varying, 'expired'::character varying])::text[])))
  '''
}

Table commerce.offer {
  id bigint [pk, increment]
  public_id varchar(50) [not null, unique]
  course_id bigint [not null]
  price_type varchar(10) [not null]
  amount bigint [not null]
  currency char(3)
  is_active boolean [not null, default: true]
  created_by bigint
  created_at timestamptz [not null, default: `now()`]
  deactivated_at timestamptz

  indexes {
    (course_id, price_type) [unique, name: 'uq_offer_active', note: 'WHERE is_active']
  }

  Note: '''
  Course prices. money: amount in minor units of currency; points: amount in points. Never updated in place except to deactivate
  chk_offer_amount: CHECK ((amount > 0))
  chk_offer_currency: CHECK (((((price_type)::text = 'money'::text) AND (currency ~ '^[A-Z]{3}$'::text)) OR (((price_type)::text = 'points'::text) AND (currency IS NULL))))
  chk_offer_price_type: CHECK (((price_type)::text = ANY ((ARRAY['money'::character varying, 'points'::character varying])::text[])))
  '''
}

Table commerce.order_items {
  id bigint [pk, increment]
  order_id bigint [not null]
  course_id bigint [not null]
  price numeric(12,2) [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  offer_id bigint
  amount_minor bigint
  points bigint

  indexes {
    (order_id, course_id) [unique, name: 'uq_order_course']
    course_id [name: 'idx_order_items_course']
  }

  Note: '''
  chk_order_items_amounts: CHECK (((COALESCE(amount_minor, (0)::bigint) >= 0) AND (COALESCE(points, (0)::bigint) >= 0)))
  order_items_price_check: CHECK ((price >= (0)::numeric))
  '''
}

Table commerce.orders {
  id bigint [pk, increment]
  public_id varchar(50) [not null, unique]
  user_id bigint [not null]
  status public.order_status [not null, default: 'pending']
  payment_method public.payment_method [not null, default: 'banking']
  total numeric(12,2) [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
  currency char(3)
  amount_minor bigint
  points_total bigint
  idempotency_key varchar(100)
  expires_at timestamptz
  paid_at timestamptz
  failed_at timestamptz
  cancelled_at timestamptz
  refunded_at timestamptz
  failure_reason varchar(100)

  indexes {
    (user_id, expires_at) [name: 'idx_orders_pending', note: 'WHERE (status = \'pending\'::order_status)']
    (user_id, created_at) [name: 'idx_orders_user']
    (user_id, idempotency_key) [unique, name: 'uq_orders_user_idempotency', note: 'WHERE (idempotency_key IS NOT NULL)']
  }

  Note: '''
  chk_orders_amounts: CHECK (((COALESCE(amount_minor, (0)::bigint) >= 0) AND (COALESCE(points_total, (0)::bigint) >= 0)))
  chk_orders_currency: CHECK (((currency IS NULL) OR (currency ~ '^[A-Z]{3}$'::text)))
  orders_total_check: CHECK ((total >= (0)::numeric))
  '''
}

Table commerce.payment {
  id bigint [pk, increment]
  public_id varchar(50) [not null, unique]
  order_id bigint [not null]
  provider varchar(30) [not null]
  provider_ref varchar(255)
  checkout_url text
  status varchar(20) [not null, default: 'pending']
  amount_minor bigint [not null]
  currency char(3) [not null]
  failure_code varchar(100)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  succeeded_at timestamptz
  refunded_at timestamptz

  indexes {
    order_id [name: 'idx_payment_order']
    (provider, provider_ref) [unique, name: 'uq_payment_provider_ref', note: 'WHERE (provider_ref IS NOT NULL)']
  }

  Note: '''
  chk_payment_amount: CHECK ((amount_minor > 0))
  chk_payment_currency: CHECK ((currency ~ '^[A-Z]{3}$'::text))
  chk_payment_provider: CHECK (((provider)::text ~ '^[a-z0-9_]+$'::text))
  chk_payment_status: CHECK (((status)::text = ANY ((ARRAY['pending'::character varying, 'succeeded'::character varying, 'failed'::character varying, 'cancelled'::character varying, 'refunded'::character varying, 'disputed'::character varying])::text[])))
  '''
}

Table commerce.payment_event {
  id bigint [pk, increment]
  provider varchar(30) [not null]
  event_id varchar(255) [not null]
  event_type varchar(50) [not null]
  provider_ref varchar(255)
  payment_id bigint
  payload_sha256 char(64) [not null]
  result varchar(40)
  received_at timestamptz [not null, default: `now()`]
  processed_at timestamptz

  indexes {
    (provider, event_id) [unique, name: 'uq_payment_event']
    payment_id [name: 'idx_payment_event_payment']
  }

  Note: '''
  Verified webhook deliveries; the unique key makes duplicate deliveries no-ops. Raw payloads are not stored
  '''
}

Table community.comment {
  public_id uuid [not null, unique, default: `gen_random_uuid()`]
  user_id bigint [not null]
  reference_id bigint [not null]
  content text [not null]
  upvotes bigint [default: 0]
  downvotes bigint [default: 0]
  is_hidden boolean [default: false]
  is_deleted boolean [default: false]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  rating int [not null, default: 1]
  id bigint [pk, increment]

  indexes {
    (reference_id, created_at) [name: 'idx_comment_course_created', note: 'WHERE (is_deleted = false)']
  }

  Note: '''
  chk_comment_rating: CHECK (((rating >= 1) AND (rating <= 5)))
  '''
}

Table community.event {
  id uuid [pk, default: `gen_random_uuid()`]
  subject varchar(255) [not null]
  content text [not null]
  upvotes bigint [default: 0]
  downvotes bigint [default: 0]
  is_hidden boolean [default: false]
  is_deleted boolean [default: false]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  created_by bigint [not null]
}

Table community.event_join {
  is_cancelled boolean [default: false]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  user_id bigint
  event_id uuid

  indexes {
    (event_id, user_id) [pk]
    user_id [name: 'idx_event_join_user']
  }
}

Table community.feedback {
  title varchar(255) [not null]
  feedback text [not null]
  created_at timestamptz [default: `now()`]
  id uuid [pk, default: `gen_random_uuid()`]
  user_id bigint
}

Table community.friend {
  id uuid [pk, default: `gen_random_uuid()`]
  sender_id bigint [not null]
  receiver_id bigint [not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  status public.status_friend_request_enum [not null]

  indexes {
    receiver_id [name: 'idx_friend_receiver']
    (`LEAST(sender_id, receiver_id)`, `GREATEST(sender_id, receiver_id)`) [unique, name: 'uq_friend_pair']
  }

  Note: '''
  chk_friend_not_self: CHECK ((sender_id <> receiver_id))
  '''
}

Table community.messages {
  id int [pk, increment]
  message text [not null]
  created_at timestamp [default: `now()`]
  sender_id bigint [not null]
  receiver_id bigint [not null]
  read_at timestamp

  indexes {
    (`LEAST(sender_id, receiver_id)`, `GREATEST(sender_id, receiver_id)`, created_at) [name: 'idx_messages_conversation']
  }
}

Table community.team {
  id varchar(50) [pk]
  name varchar(20) [not null]
  size int [not null]
  created_at timestamp [default: `now()`]
  image_url text [default: '/image/static/default.svg']
  description text
  updated_at timestamp
  host_id bigint [not null]

  indexes {
    host_id [name: 'idx_team_host']
  }

  Note: '''
  chk_team_size: CHECK (((size >= 2) AND (size <= 5)))
  '''
}

Table community.team_members {
  id bigint [pk, increment]
  team_id varchar(50) [not null]
  user_id bigint [not null]
  status public.join_team_status [not null, default: 'pending']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp

  indexes {
    (team_id, user_id) [unique, name: 'uq_team_member']
    (user_id, status) [name: 'idx_team_members_user']
  }
}

Table community.voting {
  user_id bigint
  created_at timestamp [default: `now()`]
  reference_id bigint
  voting public.voting_enum [not null]
  updated_at timestamp

  indexes {
    (user_id, reference_id) [pk]
    reference_id [name: 'idx_voting_comment']
  }
}

Table course.lesson {
  module_id bigint [not null]
  title varchar(255) [not null]
  content_type varchar(50)
  content_source text
  order_index int [not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  is_hidden boolean [not null, default: false]
  is_deleted boolean [not null, default: false]
  id bigint [pk, increment]

  indexes {
    (module_id, order_index) [name: 'idx_lesson_module']
  }
}

Table course.module {
  course_id bigint [not null]
  title varchar(255) [not null]
  order_index int [not null]
  created_at timestamp [default: `now()`]
  lessons int [not null, default: 0]
  updated_at timestamp [default: `now()`]
  is_hidden boolean [not null, default: false]
  is_deleted boolean [not null, default: false]
  id bigint [pk, increment]

  indexes {
    (course_id, order_index) [name: 'idx_module_course']
  }
}

Table identity.accounts {
  id int [pk, increment]
  user_id bigint [not null]
  provider_account_id varchar(255)
  is_authenticated boolean [default: false]
  created_at timestamp [default: `now()`]
  password_hash text
  provider public.provider_enum
  provider_email varchar(255)

  indexes {
    (provider_account_id, provider) [unique, name: 'account_provider_pkey']
    (user_id, provider) [unique, name: 'accounts_user_provider_uq']
    user_id [name: 'idx_accounts_user']
  }
}

Table identity.audit_log {
  id bigint [pk, increment]
  actor_id bigint
  action varchar(60) [not null]
  target_type varchar(40) [not null]
  target_id varchar(100) [not null]
  reason text
  before jsonb
  after jsonb
  ip_address varchar(64)
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (actor_id, created_at) [name: 'idx_audit_log_actor']
    (target_type, target_id, created_at) [name: 'idx_audit_log_target']
  }

  Note: '''
  Append-only log of privileged (admin / course manager) actions
  '''
}

Table identity.auth_outbox {
  id bigint [pk, increment]
  event_type varchar(50) [not null]
  payload jsonb [not null]
  created_at timestamptz [not null, default: `now()`]
  available_at timestamptz [not null, default: `now()`]
  attempts int [not null, default: 0]
  last_error text
  processed_at timestamptz

  indexes {
    (available_at, id) [name: 'idx_auth_outbox_pending', note: 'WHERE (processed_at IS NULL)']
  }
}

Table identity.email_tokens {
  id bigint [pk, increment]
  user_id bigint [not null]
  purpose text [not null]
  email varchar(255) [not null]
  token_hash text [not null, unique]
  expires_at timestamptz [not null]
  consumed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  payload jsonb

  indexes {
    (user_id, purpose) [unique, name: 'email_tokens_live_uq', note: 'WHERE (consumed_at IS NULL)']
  }

  Note: '''
  email_tokens_purpose_check: CHECK ((purpose = ANY (ARRAY['verify_email'::text, 'link_account'::text])))
  '''
}

Table identity.permissions {
  id bigint [pk, increment]
  resource varchar(100) [not null]
  action varchar(50) [not null]
  description text
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp

  indexes {
    (resource, action) [unique, name: 'permissions_resource_action_unique']
  }
}

Table identity.refresh_tokens {
  id bigint [pk]
  session_id bigint [not null]
  refresh_token_hash varchar [not null, unique]
  rotated_at timestamptz
  rotated_to_token_id bigint
  created_at timestamptz
  issued_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]
  consumed_at timestamptz
  revoked_at timestamptz
  replaced_by_id bigint
  recovery_key_hash varchar(64)
  recovery_sealed text
  recovery_expires_at timestamptz

  indexes {
    recovery_expires_at [name: 'idx_refresh_tokens_recovery_expires', note: 'WHERE (recovery_expires_at IS NOT NULL)']
    session_id [name: 'idx_refresh_tokens_session']
    session_id [unique, name: 'uq_refresh_tokens_one_current_per_session', note: 'WHERE ((consumed_at IS NULL) AND (revoked_at IS NULL))']
  }
}

Table identity.role_permissions {
  role_id bigint
  permission_id bigint
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (role_id, permission_id) [pk]
    permission_id [name: 'idx_role_permissions_permission']
  }
}

Table identity.roles {
  id bigint [pk, increment]
  code varchar(100) [not null, unique]
  name varchar(255) [not null]
  description text
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp
}

Table identity.sessions {
  id bigint [pk]
  user_id bigint [not null]
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  revoked_at timestamptz
  is_revoked boolean [default: false]
  user_agent varchar(255)
  last_seen_at timestamptz
  last_refreshed_at timestamptz
  idle_expires_at timestamptz [not null]
  absolute_expires_at timestamptz [not null]
  revoke_reason varchar(50)
  ip_address varchar(64)

  indexes {
    user_id [name: 'idx_sessions_active', note: 'WHERE (revoked_at IS NULL)']
    expires_at [name: 'idx_sessions_expires_at']
    idle_expires_at [name: 'idx_sessions_idle_expires_at']
    user_id [name: 'idx_sessions_user_id']
  }
}

Table identity.user_roles {
  user_id bigint
  role_id bigint
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (user_id, role_id) [pk]
    role_id [name: 'idx_user_roles_role']
  }
}

Table identity.users {
  public_id varchar(50) [not null, unique]
  username varchar(255) [not null, unique]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  status public.user_status_enum [not null, default: 'active']
  id bigint [pk, increment]
  email varchar(255) [not null, unique]
  email_verified boolean [default: false]

  indexes {
    `lower(email::text)` [unique, name: 'users_email_lower_uq']
  }
}

Table learning.favorite {
  id bigint [pk, increment]
  course_id bigint [not null]
  user_id bigint [not null]
  created_at timestamp [default: `now()`]

  indexes {
    (user_id, course_id) [unique, name: 'unique_favorite']
    course_id [name: 'idx_favorite_course']
  }
}

Table learning.history {
  user_id bigint
  course_id bigint [not null]
  lesson_id bigint
  created_at timestamp [default: `now()`]
  updated_at timestamp
  module_id bigint [not null]
  last_seen timestamp
  status public.status_progress_enum [not null, default: 'enrolled']

  indexes {
    (user_id, lesson_id) [pk]
    lesson_id [name: 'idx_history_lesson']
    (user_id, course_id) [name: 'idx_history_user_course']
  }
}

Table learning.recovery {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id bigint [not null]
  course_id bigint [not null]
  created_at timestamp [default: `now()`]
  module_id bigint [not null]
  lesson_id bigint [not null]
  status public.status_progress_enum [not null]
}

Table learning.register {
  user_id bigint
  course_id bigint
  progress int [default: 0]
  created_at timestamptz [default: `now()`]
  is_marked boolean [default: false]
  last_seen timestamptz
  is_deleted boolean [default: false]
  deleted_at timestamptz
  is_archived boolean [default: false]
  status public.status_course_enum [default: 'enrolled']

  indexes {
    (user_id, course_id) [pk]
    course_id [name: 'idx_register_course']
  }

  Note: '''
  chk_register_progress: CHECK ((progress >= 0))
  '''
}

Table profile.exp_level {
  level int [pk]
  title varchar(60) [not null]
  min_exp bigint [not null, unique]
  is_active boolean [not null, default: true]

  Note: '''
  exp_level_level_check: CHECK ((level >= 1))
  exp_level_min_exp_check: CHECK ((min_exp >= 0))
  '''
}

Table profile.exp_rule {
  rule_key varchar(60) [pk]
  amount int [not null]
  is_active boolean [not null, default: true]
  updated_at timestamptz [not null, default: `now()`]

  Note: '''
  exp_rule_amount_check: CHECK ((amount > 0))
  '''
}

Table profile.exp_transaction {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id bigint [not null]
  amount int [not null]
  source_type varchar(20) [not null]
  source_id bigint
  rule_key varchar(60)
  exp_after bigint [not null]
  idempotency_key varchar(120)
  actor_id bigint
  reason text
  metadata jsonb
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (source_id, user_id) [name: 'idx_exp_transaction_challenge', note: 'WHERE ((source_type)::text = \'challenge\'::text)']
    (user_id, created_at, id) [name: 'idx_exp_transaction_user_created']
    (user_id, idempotency_key) [unique, name: 'uq_exp_transaction_idempotency', note: 'WHERE (idempotency_key IS NOT NULL)']
    (user_id, source_type, source_id) [unique, name: 'uq_exp_transaction_source', note: 'WHERE (source_id IS NOT NULL)']
  }

  Note: '''
  chk_exp_transaction_adjustment: CHECK ((((source_type)::text <> 'adjustment'::text) OR ((reason IS NOT NULL) AND (length(btrim(reason)) > 0))))
  chk_exp_transaction_source: CHECK ((((source_type)::text = 'adjustment'::text) OR (source_id IS NOT NULL)))
  exp_transaction_amount_check: CHECK ((amount <> 0))
  exp_transaction_exp_after_check: CHECK ((exp_after >= 0))
  exp_transaction_source_type_check: CHECK (((source_type)::text = ANY ((ARRAY['lesson'::character varying, 'challenge'::character varying, 'course'::character varying, 'adjustment'::character varying])::text[])))
  '''
}

Table profile.info {
  surname varchar(30) [not null]
  name varchar(30) [not null]
  image text
  nickname varchar(30) [default: 'None']
  phone varchar(10)
  rank int [default: 0]
  bio text [default: 'No thing']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  user_id bigint [not null, unique]
  id uuid [pk, default: `gen_random_uuid()`]
  level public.level_enum [default: 'beginner']
  points bigint [default: 0]
  avatar_asset_id bigint [note: 'Uploaded avatar (storage.assets); NULL when image is an OAuth provider URL or empty']
  exp bigint [not null, default: 0]
  exp_level int [not null, default: 1]
  show_profile boolean [not null, default: true]
  show_learning boolean [not null, default: false]
  show_on_leaderboard boolean [not null, default: true]

  indexes {
    avatar_asset_id [name: 'idx_info_avatar_asset', note: 'WHERE (avatar_asset_id IS NOT NULL)']
  }

  Note: '''
  chk_info_counters: CHECK (((rank >= 0) AND (points >= 0)))
  chk_info_exp: CHECK (((exp >= 0) AND (exp_level >= 1)))
  '''
}

Table profile.learning_preference {
  user_id bigint [pk]
  career_role_id int
  experience_level varchar(20)
  preferred_language_id int [note: 'Optional: programming language favoured by recommendations']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '''
  chk_learning_preference_level: CHECK (((experience_level IS NULL) OR ((experience_level)::text = ANY ((ARRAY['beginner'::character varying, 'junior'::character varying, 'intermediate'::character varying, 'advanced'::character varying])::text[]))))
  '''
}

Table profile.notification {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id bigint [not null]
  message text [not null]
  has_seen boolean [default: false]
  is_archive boolean [default: false]
  is_deleted boolean [default: false]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]

  indexes {
    (user_id, created_at) [name: 'idx_notification_user', note: 'WHERE (is_deleted = false)']
  }
}

Table profile.onboarding {
  user_id bigint [pk]
  status varchar(20) [not null, default: 'not_started']
  current_step varchar(20) [not null, default: 'role']
  started_at timestamptz
  completed_at timestamptz
  skipped_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '''
  Explicit onboarding state per user; current_step is where an in-progress onboarding resumes
  chk_onboarding_completed_at: CHECK ((((status)::text <> 'completed'::text) OR (completed_at IS NOT NULL)))
  chk_onboarding_skipped_at: CHECK ((((status)::text <> 'skipped'::text) OR (skipped_at IS NOT NULL)))
  chk_onboarding_status: CHECK (((status)::text = ANY ((ARRAY['not_started'::character varying, 'in_progress'::character varying, 'skipped'::character varying, 'completed'::character varying])::text[])))
  chk_onboarding_step: CHECK (((current_step)::text = ANY ((ARRAY['role'::character varying, 'industry'::character varying, 'level_goals'::character varying, 'review'::character varying, 'recommendations'::character varying])::text[])))
  '''
}

Table profile.point_transaction {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id bigint [not null]
  amount bigint [not null]
  action varchar [not null]
  source_type varchar [not null]
  source_id bigint [not null]
  created_at timestamptz [default: `now()`]
  entry_type varchar(20) [not null]
  balance_after bigint
  idempotency_key varchar(120)
  order_id bigint
  actor_id bigint
  reason text

  indexes {
    (user_id, source_type, source_id, action) [unique, name: 'uq_point_transaction_source']
    (user_id, created_at) [name: 'idx_point_transaction_earned', note: 'WHERE (((action)::text = \'credit\'::text) AND ((entry_type)::text = \'earned\'::text))']
    (user_id, created_at) [name: 'idx_point_transaction_user_created']
    (user_id, idempotency_key) [unique, name: 'uq_point_transaction_idempotency', note: 'WHERE (idempotency_key IS NOT NULL)']
  }

  Note: '''
  check_amount: CHECK ((amount > 0))
  chk_point_transaction_action: CHECK (((action)::text = ANY ((ARRAY['credit'::character varying, 'debit'::character varying])::text[])))
  chk_point_transaction_balance: CHECK (((balance_after IS NULL) OR (balance_after >= 0)))
  chk_point_transaction_entry_type: CHECK (((((entry_type)::text = ANY ((ARRAY['earned'::character varying, 'refunded'::character varying])::text[])) AND ((action)::text = 'credit'::text)) OR (((entry_type)::text = ANY ((ARRAY['spent'::character varying, 'expired'::character varying])::text[])) AND ((action)::text = 'debit'::text)) OR ((entry_type)::text = 'adjusted'::text)))
  '''
}

Table profile.rank_tier {
  kind varchar(10)
  tier int
  title varchar(40) [not null]
  min_score bigint [not null]

  indexes {
    (kind, tier) [pk]
    (kind, min_score) [unique, name: 'rank_tier_kind_min_score_key']
  }

  Note: '''
  rank_tier_kind_check: CHECK (((kind)::text = ANY ((ARRAY['overall'::character varying, 'exp'::character varying, 'points'::character varying])::text[])))
  rank_tier_min_score_check: CHECK ((min_score >= 0))
  rank_tier_tier_check: CHECK ((tier >= 1))
  '''
}

Table profile.task {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id bigint [not null]
  title varchar(255) [not null]
  description text
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  status public.task_status_enum [not null]
  priority public.task_priority_enum [not null]

  indexes {
    (user_id, status) [name: 'idx_task_user']
  }
}

Table profile.user_industry {
  user_id bigint
  industry_id int
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, industry_id) [pk]
    industry_id [name: 'idx_user_industry_industry']
  }
}

Table profile.user_learning_goal {
  user_id bigint
  learning_goal_id int
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, learning_goal_id) [pk]
    learning_goal_id [name: 'idx_user_learning_goal_goal']
  }
}

Table public.schema_migrations {
  version varchar(12) [pk]
  name text [not null]
  checksum char(64) [not null]
  applied_at timestamptz [not null, default: `now()`]
  applied_by text
}

Table roadmap.node_course {
  node_id bigint
  course_id bigint
  priority int [default: 0]
  created_at timestamp [default: `now()`]

  indexes {
    (node_id, course_id) [pk]
    course_id [name: 'idx_node_course_course']
  }
}

Table roadmap.nodes {
  roadmap_id bigint [not null]
  title varchar(255) [not null]
  description text
  created_at timestamp [default: `now()`]
  updated_at timestamp
  order_index int [default: 0]
  id bigint [pk, increment]

  indexes {
    roadmap_id [name: 'idx_roadmap_nodes_roadmap_id']
  }
}

Table roadmap.roadmap_users {
  user_id bigint
  roadmap_id bigint
  completed_nodes int [default: 0]
  total_nodes int [default: 0]
  progress_percent numeric(5,2) [default: 0]
  current_node_id bigint [not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp

  indexes {
    (user_id, roadmap_id) [pk]
    roadmap_id [name: 'idx_roadmap_users_roadmap']
  }
}

Table roadmap.roadmaps {
  title varchar(255) [not null]
  description text
  created_at timestamp [default: `now()`]
  updated_at timestamp
  public_id uuid [unique, default: `gen_random_uuid()`]
  id bigint [pk, increment]
  level public.level_enum
  career_role_id int
}

Table roadmap.user_progress {
  user_id bigint [not null]
  roadmap_id bigint [not null]
  node_id bigint [not null]
  is_completed boolean [default: false]
  completed_at timestamp
  created_at timestamp [default: `now()`]
  id uuid [pk, default: `gen_random_uuid()`]

  indexes {
    (user_id, node_id) [unique, name: 'uq_user_node']
    node_id [name: 'idx_roadmap_progress_node']
    roadmap_id [name: 'idx_roadmap_progress_roadmap']
  }
}

Table storage.assets {
  id bigint [pk, increment]
  public_id varchar(100) [not null, unique]
  provider varchar(30) [not null]
  object_key text [note: 'S3 object key, or the Cloudinary public_id']
  external_url text [note: 'Delivery URL (Cloudinary secure_url); NULL for S3 objects read through the API']
  resource_type varchar(50) [not null]
  mine_type varchar(100) [note: 'MIME type (column name misspelled historically; kept for compatibility)']
  file_size bigint
  original_name varchar(100)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
  owner_id bigint [note: 'Uploading user, NULL for platform content (seeded challenge files)']
  purpose varchar(30) [note: 'avatar | challenge_file | submission | ...']
  width int
  height int
  format varchar(20)
  version bigint [note: 'Cloudinary version of the stored file']
  checksum varchar(64) [note: 'SHA-256 (hex) of the uploaded bytes']
  deleted_at timestamptz [note: 'Set when the file was replaced / removed from the provider']

  indexes {
    (owner_id, purpose) [name: 'idx_assets_owner_purpose', note: 'WHERE ((owner_id IS NOT NULL) AND (deleted_at IS NULL))']
    (provider, object_key) [unique, name: 'uq_assets_provider_object_key', note: 'WHERE (object_key IS NOT NULL)']
  }

  Note: '''
  chk_assets_dimensions: CHECK ((((width IS NULL) OR (width > 0)) AND ((height IS NULL) OR (height > 0))))
  chk_assets_provider: CHECK (((provider)::text = ANY ((ARRAY['s3'::character varying, 'cloudinary'::character varying])::text[])))
  '''
}

