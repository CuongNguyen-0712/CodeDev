// CodeDev database diagram - paste into https://dbdiagram.io
// Generated by db/tools/export-schema.mjs on 2026-10-23. Do not edit by hand.

Project codedev {
  database_type: 'PostgreSQL'
  Note: '''
  - **public**: standard public schema
  - **challenge**: Lesson challenges: quizzes and coding exercises
  - **course**: Course content structure: modules, lessons
  - **roadmap**: Learning roadmaps and per-user roadmap progress
  - **storage**: Stored file metadata (S3 / Cloudinary assets)
  - **identity**: Authentication & authorization: users, accounts, sessions, RBAC
  - **profile**: Per-user data: profile info, points ledger, notifications, tasks
  - **catalog**: Course catalog: courses, categories, languages
  - **learning**: Learner state: enrollments, lesson progress, favorites, recovery
  - **community**: Comments, votes, events, feedback, teams, friendships, messages
  - **commerce**: Cart and orders
  - Views: learning.user_progress, profile.exp_drift, profile.point_balance_drift
  '''
}

