      "name": "first-paid-order-by-referral-source",
      "type": "mini_coding",
      "title": "Average first paid order by referral source, in CTE steps",
      "description": "Marketing wants the average value of each customer's FIRST paid order, per referral source. Write one query with named steps (WITH ... AS): keep paid orders, pick each customer's first paid order (earliest ordered_at, smallest order_id on a tie), attach the referral source (NULL becomes 'unknown'), then summarize. Return [source, paying_customers, avg_first_order_cents] rows, rounded to whole cents, ordered by paying_customers DESC, then source.",
      "difficulty": "medium",
      "points": 30,
      "coding": {
        "language": "python",
        "filePath": "first_orders.py",
        "executionMode": "stdio",
        "timeLimitMs": 2000,
        "memoryLimitMb": 128,
        "scoringMode": "all_or_nothing",
        "maxAttempts": null
      },
