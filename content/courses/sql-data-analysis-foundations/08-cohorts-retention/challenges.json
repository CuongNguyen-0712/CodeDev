      "publicId": "chal_coding_sqlf_321",
      "name": "monthly-cohort-retention-table",
      "type": "mini_coding",
      "title": "Build a monthly cohort retention table",
      "description": "Group customers by the month of their first paid order and report, for every month offset that has activity, how many of them paid again and what share of the whole cohort that is. One row per (cohort_month 'YYYY-MM', months_since_first, active_customers, cohort_size, retention_pct rounded to 1 decimal), counting distinct customers, only paid orders, calendar-month offsets that work across a new year, and the cohort size as the fixed denominator. Order by cohort_month, then months_since_first.",
      "difficulty": "hard",
      "points": 30,
      "coding": {
        "language": "python",
        "filePath": "cohort_retention.py",
        "executionMode": "stdio",
        "timeLimitMs": 2000,
        "memoryLimitMb": 128,
        "scoringMode": "all_or_nothing",
        "maxAttempts": null
      },
      "tests": [
