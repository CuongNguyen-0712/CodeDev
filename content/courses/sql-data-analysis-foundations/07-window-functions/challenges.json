  "challenges": [
    {
      "publicId": "chal_quiz_sqlf_311",
      "name": "ranking-ties-and-frames-quiz",
      "type": "quiz",
      "title": "Ties in rankings and running totals",
      "description": "Two small tables with ties: predict what ROW_NUMBER, RANK and DENSE_RANK return, and what a running SUM with the default window frame adds up when several rows share the same ORDER BY value.",
      "difficulty": "medium",
      "points": 10,
      "questions": [
        {
          "type": "multiple_choice",
          "points": 5,
          "question": "Five products and their revenue:\n\nA 900, B 700, C 700, D 500, E 300\n\nEach row gets ROW_NUMBER() OVER (ORDER BY revenue DESC, name), RANK() OVER (ORDER BY revenue DESC) and DENSE_RANK() OVER (ORDER BY revenue DESC). Which statements are true? (Select all that apply.)",
          "explanation": "B and C tie at 700. ROW_NUMBER never repeats a number, so they get 2 and 3 (the name decides who is first). RANK gives both 2 and then skips: D is 4, because three products have a higher revenue. DENSE_RANK gives both 2 and does not skip: D is 3, E is 4. So a filter rank <= 3 keeps A, B, C (3 rows: there is no rank 3), and dense_rank <= 3 keeps A, B, C and D (4 rows). For a top-N slide, decide first what a tie at the cut-off should do, then pick the function.",
          "options": [
            {
              "text": "D gets RANK 4.",
              "correct": true
            },
            {
              "text": "D gets DENSE_RANK 3.",
              "correct": true
            },
            {
              "text": "B and C get the same ROW_NUMBER.",
              "correct": false
            },
            {
              "text": "WHERE rank <= 3 keeps 4 rows.",
              "correct": false
            },
            {
              "text": "WHERE dense_rank <= 3 keeps 4 rows.",
              "correct": true
            }
          ]
        },
        {
          "type": "single_choice",
          "points": 5,
          "question": "A small table sales, one row per order:\n\nid  day    amount\n1   03-01  100\n2   03-01   50\n3   03-02  200\n4   03-02   30\n5   03-03   20\n\nSELECT id, SUM(amount) OVER (ORDER BY day) AS to_date FROM sales ORDER BY id;\n\nWhat is to_date for ids 1 to 5?",
          "explanation": "With ORDER BY and no frame clause, the frame is RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW. RANGE works on values, not rows: the current row's peers (every row with the same day) are all inside the frame. So both 03-01 rows get 100 + 50 = 150, both 03-02 rows get 150 + 230 = 380, and 03-03 gets 400. 100, 150, 350, 380, 400 is what ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW gives with ORDER BY day, id. To get one point per day, aggregate per day first, then run the window over the daily rows.",
          "options": [
            {
              "text": "150, 150, 380, 380, 400",
              "correct": true
            },
            {
              "text": "100, 150, 350, 380, 400",
              "correct": false
            },
            {
              "text": "150, 150, 230, 230, 20",
              "correct": false
            },
            {
              "text": "400, 400, 400, 400, 400",
              "correct": false
            }
          ]
        }
      ]
    },
