                        "memory": "768Mi"
                      }
                    },
                    "usage": {
                      "cpu": "100m",
                      "memory": "300Mi"
                    }
                  }
                ]
              },
              {
                "name": "api-b",
                "containers": [
                  {
                    "name": "api",
                    "resources": {
                      "requests": {
                        "cpu": "700m",
                        "memory": "512Mi"
                      },
                      "limits": {
                        "memory": "768Mi"
                      }
