{
  "challenges": [
    {
      "publicId": "chal_coding_devf_221",
      "name": "validate-env-config-at-startup",
      "type": "mini_coding",
      "title": "Check the api's environment at startup",
      "description": "Rice Rocket's api takes all of its configuration from environment variables: the port, DEBUG, the database and Redis URLs, the log level, the number of workers and the payment API key. Write load_config(schema, env), which checks every variable the schema lists before the app starts: strip spaces, treat empty values as not set, fall back to defaults, parse int, bool, url and enum values strictly (DEBUG=false must be False), and collect every problem instead of stopping at the first. Secrets must never appear in the output: not in the config (shown as ***) and not in error messages. The runner at the bottom prints the result as JSON.",
      "difficulty": "medium",
      "points": 30,
      "coding": {
        "language": "python",
        "filePath": "config_check.py",
        "executionMode": "stdio",
        "timeLimitMs": 2000,
        "memoryLimitMb": 128,
        "scoringMode": "all_or_nothing",
        "maxAttempts": null
      },
      "tests": [
        {
          "name": "Production: every variable set, spaces stripped, DEBUG=false is False, secrets shown as ***",
          "input": {
            "schema": [
              {
                "name": "PORT",
                "type": "int",
                "default": "8080",
                "min": 1,
                "max": 65535
              },
              {
                "name": "DEBUG",
                "type": "bool",
                "default": "false"
              },
              {
                "name": "DATABASE_URL",
                "type": "url",
                "secret": true
              },
              {
                "name": "REDIS_URL",
                "type": "url",
                "default": "redis://redis:6379/0"
              },
              {
                "name": "LOG_LEVEL",
                "type": "enum",
                "choices": [
                  "DEBUG",
                  "INFO",
                  "WARNING",
                  "ERROR"
                ],
                "default": "INFO"
              },
              {
                "name": "WORKERS",
                "type": "int",
                "default": "2",
                "min": 1,
                "max": 16
              },
              {
                "name": "PAYMENT_API_KEY",
                "type": "str",
                "secret": true
              }
            ],
            "env": {
              "PORT": " 8000 ",
              "DEBUG": "false",
              "DATABASE_URL": "postgres://api:Pr0d-Rice-2026@db.prod.internal:5432/ricerocket",
              "REDIS_URL": "redis://cache.prod.internal:6379/0",
              "LOG_LEVEL": "WARNING",
              "WORKERS": "8",
              "PAYMENT_API_KEY": "pk_live_51Hx9Rice",
              "PATH": "/usr/local/bin:/usr/bin",
              "HOME": "/root"
            }
          },
          "expected": {
            "ok": true,
            "config": {
              "PORT": 8000,
              "DEBUG": false,
              "DATABASE_URL": "***",
              "REDIS_URL": "redis://cache.prod.internal:6379/0",
              "LOG_LEVEL": "WARNING",
              "WORKERS": 8,
              "PAYMENT_API_KEY": "***"
            },
            "defaults_used": [],
            "errors": []
          },
          "hidden": false,
          "score": 5
        },
        {
          "name": "Staging: only the secrets are set, an empty DEBUG counts as not set, defaults fill the rest",
          "input": {
            "schema": [
              {
                "name": "PORT",
                "type": "int",
                "default": "8080",
                "min": 1,
                "max": 65535
              },
              {
                "name": "DEBUG",
                "type": "bool",
                "default": "false"
              },
              {
                "name": "DATABASE_URL",
                "type": "url",
                "secret": true
              },
              {
                "name": "REDIS_URL",
                "type": "url",
                "default": "redis://redis:6379/0"
              },
              {
                "name": "LOG_LEVEL",
                "type": "enum",
                "choices": [
                  "DEBUG",
                  "INFO",
                  "WARNING",
                  "ERROR"
                ],
                "default": "INFO"
              },
              {
                "name": "WORKERS",
                "type": "int",
                "default": "2",
                "min": 1,
                "max": 16
              },
              {
                "name": "PAYMENT_API_KEY",
                "type": "str",
                "secret": true
              }
            ],
            "env": {
              "DEBUG": "",
              "DATABASE_URL": "postgres://api:st4ging@db.staging.internal/ricerocket",
              "PAYMENT_API_KEY": "pk_test_51Hx9Rice"
            }
          },
          "expected": {
            "ok": true,
            "config": {
              "PORT": 8080,
              "DEBUG": false,
              "DATABASE_URL": "***",
              "REDIS_URL": "redis://redis:6379/0",
              "LOG_LEVEL": "INFO",
              "WORKERS": 2,
              "PAYMENT_API_KEY": "***"
            },
            "defaults_used": [
              "PORT",
              "DEBUG",
              "REDIS_URL",
              "LOG_LEVEL",
              "WORKERS"
            ],
            "errors": []
          },
          "hidden": false,
          "score": 5
        },
        {
          "name": "Five problems are reported together, and the bad secret URL is not echoed",
          "input": {
            "schema": [
              {
                "name": "PORT",
                "type": "int",
                "default": "8080",
                "min": 1,
                "max": 65535
              },
              {
                "name": "DEBUG",
                "type": "bool",
