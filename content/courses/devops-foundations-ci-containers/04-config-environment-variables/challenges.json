            ],
            "env": {
              "PORT": "80a",
              "DEBUG": "flase",
              "DATABASE_URL": "db.prod.internal:5432/ricerocket",
              "LOG_LEVEL": "info"
            }
          },
          "expected": {
            "ok": false,
            "config": null,
            "defaults_used": [
