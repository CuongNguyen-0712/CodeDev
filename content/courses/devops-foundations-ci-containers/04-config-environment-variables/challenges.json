              },
              {
                "name": "DATABASE_URL",
                "type": "url",
                "secret": true
              },
              {
                "name": "REDIS_URL",
                "type": "url",
                "default": "redis://redis:6379/0"
              },
              {
                "name": "LOG_LEVEL",
                "type": "enum",
                "choices": [
                  "DEBUG",
                  "INFO",
                  "WARNING",
                  "ERROR"
                ],
                "default": "INFO"
              },
              {
                "name": "WORKERS",
                "type": "int",
                "default": "2",
