            "errors": [
              "PORT: not an integer: '80a'",
              "DEBUG: not a boolean: 'flase'",
              "DATABASE_URL: not a URL (need scheme://host): (value hidden)",
              "LOG_LEVEL: must be one of DEBUG, INFO, WARNING, ERROR, got 'info'",
              "PAYMENT_API_KEY: required but not set"
            ]
          },
          "hidden": false,
          "score": 5
        },
