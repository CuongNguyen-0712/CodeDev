                "status": 0,
                "meaning": "ok",
                "commands": [
                  "ok"
                ]
              },
              {
                "name": "migrate",
                "status": 0,
                "meaning": "ok",
                "commands": [
                  "error (exit 1)",
                  "ok"
                ]
              },
              {
                "name": "smoke-test",
                "status": 0,
                "meaning": "ok",
                "commands": [
                  "ok"
                ]
              }
