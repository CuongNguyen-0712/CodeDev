        "language": "python",
        "filePath": "exit_report.py",
        "executionMode": "stdio",
        "timeLimitMs": 2000,
        "memoryLimitMb": 128,
        "scoringMode": "all_or_nothing",
        "maxAttempts": null
      },
      "tests": [
        {
          "name": "The incident: migrate.sh | tee without pipefail looks green",
          "input": {
            "pipefail": false,
            "steps": [
