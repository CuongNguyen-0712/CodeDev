      "publicId": "chal_fix_py_rag_121",
      "name": "near-duplicate-filter",
      "type": "fix_bug",
      "title": "Fix the near-duplicate filter",
      "description": "dedupe() is supposed to keep the first copy of every article and drop near-duplicates before indexing. In production it lets copies that differ only in capitalisation or punctuation through, drops short FAQ entries that merely quote a longer article, treats texts that differ only in their last word as identical, and crashes on empty documents. Fix tokens(), shingles() and jaccard() so that dedupe() keeps a document unless its Jaccard similarity (intersection over union of word k-shingles) to an already kept document is >= threshold.",
      "difficulty": "medium",
      "points": 20,
      "coding": {
        "language": "python",
        "filePath": "dedupe.py",
        "executionMode": "stdio",
        "timeLimitMs": 2000,
        "memoryLimitMb": 128,
        "scoringMode": "all_or_nothing",
        "maxAttempts": null
      },
      "tests": [
