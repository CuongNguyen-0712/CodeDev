{
  "challenges": [
    {
      "publicId": "chal_fix_py_rag_321",
      "name": "retrieval-metrics",
      "type": "fix_bug",
      "title": "Fix the retrieval metrics",
      "description": "evaluate() computes recall@k, MRR@k and hit rate@k over a golden set, and the numbers cannot be trusted: recall changes with k even when nothing new is found, a document ranked 20th improves MRR@5, returning the same document twice raises recall, and unlabelled queries drag every average down. Fix it so that, per query with relevant ids, the top-k is the first k retrieved ids as returned, recall = relevant ids found / relevant ids (each counted once), MRR = 1 / rank of the first relevant id within the top-k, and hit = any relevant id in the top-k. Average over labelled queries only (0.0 when there are none), rounded to 4 decimals.",
      "difficulty": "medium",
      "points": 20,
      "coding": {
        "language": "python",
        "filePath": "metrics.py",
        "executionMode": "stdio",
        "timeLimitMs": 2000,
        "memoryLimitMb": 128,
        "scoringMode": "all_or_nothing",
        "maxAttempts": null
      },
      "tests": [
        {
          "name": "Two queries at k = 3",
          "input": {
            "results": [
              {
                "query": "how long do refunds take",
                "retrieved": [
                  "kb-billing",
                  "kb-refunds",
                  "kb-plans",
                  "kb-payments"
                ],
                "relevant": [
                  "kb-refunds",
                  "kb-payments"
                ]
              },
              {
                "query": "reset 2fa",
                "retrieved": [
                  "kb-2fa",
                  "kb-login"
                ],
                "relevant": [
                  "kb-2fa"
                ]
              }
            ],
            "k": 3
          },
          "expected": {
            "recall_at_k": 0.75,
            "mrr": 0.75,
            "hit_rate": 1
          },
          "hidden": false,
          "score": 4
        },
        {
