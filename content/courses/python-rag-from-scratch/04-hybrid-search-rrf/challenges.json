{
  "challenges": [
    {
      "publicId": "chal_coding_py_rag_221",
      "name": "reciprocal-rank-fusion",
      "type": "mini_coding",
      "title": "Write rrf(rankings, top, k, weights)",
      "description": "Merge the rankings of several retrievers with weighted Reciprocal Rank Fusion: score(d) = sum of weights[i] / (k + rank_i(d)) over the rankings that contain d, with 1-based ranks and k = 60 by default. A document repeated inside one ranking counts once, at its first position. weights default to 1 and must have one entry per ranking (ValueError otherwise). Return the top documents as [[id, score], ...], highest first, scores rounded to 6 decimals; equal scores are ordered by id.",
      "difficulty": "medium",
      "points": 30,
      "coding": {
        "language": "python",
        "filePath": "fusion.py",
        "executionMode": "stdio",
        "timeLimitMs": 2000,
        "memoryLimitMb": 128,
        "scoringMode": "all_or_nothing",
        "maxAttempts": null
      },
      "tests": [
        {
          "name": "BM25 and vector results for \"sync error E1042\"",
          "input": {
            "rankings": [
              [
                "kb-e1042",
                "kb-errors",
                "blog-launch"
              ],
              [
                "kb-sync",
                "kb-errors",
                "kb-e1042"
              ]
            ],
            "top": 3
          },
          "expected": [
            [
              "kb-e1042",
              0.032266
            ],
            [
              "kb-errors",
              0.032258
            ],
            [
              "kb-sync",
              0.016393
            ]
          ],
          "hidden": false,
          "score": 4
        },
        {
          "name": "Found by both retrievers beats first place in one",
