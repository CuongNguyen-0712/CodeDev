  "challenges": [
    {
      "publicId": "chal_quiz_webf_111",
      "name": "landmarks-headings-quiz",
      "type": "quiz",
      "title": "What does the screen reader list?",
      "description": "Two questions from the rebuilt shop page: which elements of a typical article page become landmarks, and what decides the level of a heading.",
      "difficulty": "easy",
      "points": 10,
      "questions": [
        {
          "type": "single_choice",
          "points": 5,
          "question": "A screen reader user opens the landmarks list on this page. Which landmarks does it show?\n\n<body>\n  <header><a href=\"/\">Trailhead</a></header>\n  <nav aria-label=\"Primary\">...</nav>\n  <main>\n    <article>\n      <header><h1>How we test trail shoes</h1></header>\n      <section><h2>Lab tests</h2>...</section>\n      <footer>Written by Mai Tran</footer>\n    </article>\n  </main>\n  <footer>(c) 2026 Trailhead</footer>\n</body>",
          "explanation": "header and footer become banner and contentinfo only when they are not inside article, aside, main, nav or section. The article's own header and footer are just its introduction and footer, so they are not landmarks. A section is a region landmark only when it has an accessible name (aria-labelledby or aria-label), and this one has none. article is not a landmark at all. That leaves four: the page header (banner), the nav labelled Primary (navigation), main, and the page footer (contentinfo).",
          "options": [
            { "text": "banner, navigation \"Primary\", main, contentinfo", "correct": true },
            { "text": "banner, navigation \"Primary\", main, banner, region, contentinfo, contentinfo", "correct": false },
            { "text": "banner, navigation \"Primary\", main, region \"Lab tests\", contentinfo", "correct": false },
            { "text": "banner, navigation \"Primary\", main, article, contentinfo", "correct": false }
          ]
        },
        {
          "type": "multiple_choice",
          "points": 5,
          "question": "Which statements about headings are true in today's browsers and screen readers? (Select all that apply.)",
          "explanation": "The level of a heading comes from its tag, h1 to h6. The HTML \"outline algorithm\", which would have lowered an h1 nested in sections, was never implemented by browsers and was removed from the HTML standard in 2022, so a nested h1 is still announced as level 1. Choose the level from the structure (a subsection of an h2 section gets an h3) and change the size with CSS; picking h4 for its font size gives screen reader users a false table of contents. WCAG does not require exactly one h1: 1.3.1 and 2.4.6 ask that the structure is programmatically available and that headings describe their content. One h1 that names the page is a strong convention, not a pass/fail rule.",
          "options": [
            { "text": "An h1 inside two nested section elements is announced as a level-3 heading.", "correct": false },
            { "text": "The level a screen reader announces comes from the tag name, h1 to h6.", "correct": true },
            { "text": "A heading's level should follow the structure (one more than the section it belongs to), and its size is set with CSS.", "correct": true },
            { "text": "Using h4 for a card title is fine when h4 has the right font size for the design.", "correct": false },
            { "text": "A page with two h1 elements fails WCAG 2.2.", "correct": false }
          ]
        }
      ]
    },
