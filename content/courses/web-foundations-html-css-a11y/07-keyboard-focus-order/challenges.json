  "challenges": [
    {
      "publicId": "chal_quiz_webf_321",
      "name": "keyboard-access-focus-quiz",
      "type": "quiz",
      "title": "Keyboard access: buttons, focus rings and dialogs",
      "description": "The checkout's \"Apply coupon\" control got a quick fix, and the team is arguing about focus styles and the coupon dialog. Decide what still fails for keyboard users and which statements about focus are true.",
      "difficulty": "medium",
      "points": 10,
      "questions": [
        {
          "type": "single_choice",
          "points": 5,
          "question": "A developer \"fixes\" the coupon control like this:\n\n<div class=\"btn\" role=\"button\" tabindex=\"0\" onclick=\"applyCoupon()\">Apply coupon</div>\n\nA keyboard-only customer tabs to it. What happens, and why?",
          "explanation": "tabindex=\"0\" puts the div in the Tab sequence and role=\"button\" makes screen readers announce it as a button, so focus and the announced role are fixed. But a click event fires from the keyboard only on elements whose activation behaviour does it: a native <button> turns Enter and Space into a click, a <div> does not, whatever its role. The customer reaches the control and a screen reader would announce \"Apply coupon, button\", but pressing Enter or Space does nothing (Space even scrolls the page). You would have to add a keydown handler for both keys, prevent the scroll, and handle a disabled state yourself. <button type=\"button\"> gives you all of that for free.",
          "options": [
            {
              "text": "It works like a button now: tabindex=\"0\" makes it focusable and role=\"button\" makes Enter and Space trigger onclick.",
              "correct": false
            },
            {
              "text": "It still cannot receive focus, because only native controls can be focused, whatever their tabindex.",
              "correct": false
            },
            {
              "text": "It receives focus and is announced as a button, but Enter and Space do nothing (Space scrolls the page), because only native buttons turn those keys into a click.",
              "correct": true
            },
            {
              "text": "It receives focus, but screen readers announce it as \"group\", because role=\"button\" is ignored on a div.",
              "correct": false
            }
          ]
        },
        {
          "type": "multiple_choice",
          "points": 5,
          "question": "Which statements are true? (Select all that apply.)",
          "explanation": "A global outline: none with no replacement removes the only visible focus indicator, which fails 2.4.7 Focus Visible (AA); style :focus-visible instead of hiding focus. A modal opened with dialog.showModal() makes everything outside the dialog inert, and pressing Escape closes it. Positive tabindex is an anti-pattern: it pulls elements ahead of everything else on the page, so focus no longer follows the reading order (2.4.3 Focus Order) and every element added later without a tabindex ends up behind all of them. 2.4.11 Focus Not Obscured (Minimum, AA) only requires that the focused element is not ENTIRELY hidden by author content such as a sticky header; \"no part hidden\" is the AAA criterion 2.4.12 Focus Not Obscured (Enhanced).",
          "options": [
            {
              "text": "*:focus { outline: none } with no other focus style fails 2.4.7 Focus Visible.",
              "correct": true
            },
            {
              "text": "A dialog opened with showModal() makes the rest of the page inert, and pressing Escape closes it.",
              "correct": true
            },
            {
              "text": "tabindex=\"1\" on the most important field is the recommended way to let keyboard users reach it first.",
              "correct": false
            },
            {
              "text": "2.4.11 Focus Not Obscured (Minimum) fails as soon as any part of the focused element is covered by a sticky header.",
              "correct": false
            }
          ]
        }
      ]
    },
