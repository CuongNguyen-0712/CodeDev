            "flags": [
              "batch-pickup"
            ],
            "starts": [
              {
                "online": true,
                "config": {
                  "version": 1,
                  "flags": {
                    "batch-pickup": {
                      "enabled": true,
                      "killed": false,
                      "rollout": 25,
                      "rules": [
                        {
                          "platform": "android",
                          "minAppVersion": "2.4.0"
                        }
                      ]
                    },
                    "new-map": {
                      "enabled": true,
                      "killed": false,
                      "rollout": 25,
                      "rules": []
                    },
                    "voice-notes": {
                      "enabled": true,
                      "killed": false,
                      "rollout": 25,
                      "rules": []
                    },
                    "cash-summary": {
                      "enabled": true,
                      "killed": false,
                      "rollout": 100,
