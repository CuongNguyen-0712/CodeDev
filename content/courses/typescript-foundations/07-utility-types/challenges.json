{
  "challenges": [
    {
      "publicId": "chal_coding_tsf_321",
      "name": "quick-edit-patch",
      "type": "mini_coding",
      "title": "Apply quick edits with Partial, Omit and Record",
      "description": "The Chợ Sớm admin quick-edit form sends every field of a product, and the fields the admin did not touch are undefined. Spreading that patch over the product erased names and prices. Write applyPatch, which returns a new product with only the defined fields applied (a price or stock below 0 is ignored, the original product never changes, and ProductPatch = Partial<Omit<Product, \"sku\">> already forbids editing the sku), and stockSummary, which returns a Record<Category, number> with the total stock of every category, 0 included. The test runner reads the products and the edits as JSON, applies them in order and prints the products, what changed and the stock summary.",
      "difficulty": "medium",
      "points": 30,
      "coding": {
        "language": "typescript",
        "filePath": "main.ts",
        "executionMode": "stdio",
        "timeLimitMs": 3000,
        "memoryLimitMb": 128,
        "scoringMode": "all_or_nothing",
        "maxAttempts": null
      },
      "tests": [
        {
          "name": "The incident: untouched fields arrive as undefined",
          "input": {
            "products": [
              {
                "sku": "MEA-204",
                "name": "Thịt ba chỉ",
                "category": "meat",
                "price": 125000,
                "stock": 12
              },
              {
                "sku": "VEG-101",
                "name": "Cải ngọt",
                "category": "vegetables",
                "price": 12000,
                "stock": 40
              }
            ],
            "edits": [
              {
                "sku": "MEA-204",
                "patch": {
                  "name": null,
                  "category": null,
                  "price": null,
                  "stock": 25
                }
              }
            ]
          },
          "expected": "MEA-204 Thịt ba chỉ (meat) 125000 đ, stock 25\nVEG-101 Cải ngọt (vegetables) 12000 đ, stock 40\nchanged 1, originals intact\nstock: vegetables 40, fruit 0, meat 25, dairy 0, dry 0",
          "hidden": false,
          "score": 4
        },
        {
