# Real values are never committed. Three files, read as base + override (Next.js and every script):
#   .env             values that are the same locally and in production (Sanity, S3 storage,
#                    Pusher cluster, ...). Read under both files below.
#   .env.local       local development only (localhost URLs, local database and Redis, MinIO, code runner
#                    token, Payload CMS, test accounts). Wins over .env.
#   .env.production  production (also Vercel project settings); scripts take it with --env .env.production.
# A key belongs in exactly one of .env / .env.local. See docs/environments.md for what each environment uses.

# --- App
APP_ENV=development
# Admin area and studio on (default). 0 answers 404 for /admin*, /api/admin/*, /studio* (kill switch).
ADMIN_ENABLED=1
# Admin two-factor authentication (admin and super admin). 0 only for local development; refused in production and staging.
ADMIN_MFA_REQUIRED=1
# Key for the encrypted TOTP secrets, 32+ random characters, its own value per environment. Required in production
# and staging (admin 2FA answers 503 without it); local falls back to NEXTAUTH_SECRET. Changing it resets every enrolment.
# ADMIN_MFA_KEY=
# Optional: comma-separated IPv4 addresses / CIDR ranges / IPv6 addresses allowed to open the admin area.
# ADMIN_IP_ALLOWLIST=
# Outside Vercel only: the one header your proxy sets to the client address (cf-connecting-ip, x-real-ip...).
# Needed for ADMIN_IP_ALLOWLIST and spoof-proof rate limits when self-hosting; on Vercel x-vercel-forwarded-for is used.
# CLIENT_IP_HEADER=
# Staging only (.env.staging): shared sign-in password set by `npm run db:anonymize`.
# STAGING_PASSWORD=
NEXT_PUBLIC_API_URL=http://localhost:3000/api
MACHINE_ID=1

# --- Auth (NextAuth + session tokens)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_ALLOWED_ORIGINS=
AUTH_CRON_SECRET=
# Bearer token for the full GET /api/health report (anyone else gets only { status }).
HEALTH_TOKEN=
# Monitoring (docs/docker.md): local Grafana in compose, or Grafana Cloud with grafana:push.
GRAFANA_URL=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PG_PASSWORD=
# GRAFANA_TOKEN=          (grafana:push only)
REFRESH_TOKEN_HASH_SECRET=
REFRESH_TOKEN_RECOVERY_KEY=
# Email (lib/mailConfig.mjs). Check any env file with `npm run mail:test -- --env <file> --to <you>`.
# AGENTMAIL_API_KEY and MAIL_PASSWORD empty: development sends to Mailpit (compose.yml, inbox http://127.0.0.1:8025).
# Production sends through AgentMail (smtp.agentmail.to:465) and falls back to Gmail on any AgentMail error.
# AgentMail: AGENTMAIL_API_KEY + AGENTMAIL_FROM = the inbox, e.g. CodeDev <codedev@agentmail.to>.
# AGENTMAIL_API_KEY=
# AGENTMAIL_FROM=
# AGENTMAIL_HOST=smtp.agentmail.to
# Gmail (fallback): MAIL_FROM = a Gmail address, MAIL_PASSWORD = its App Password (smtp.gmail.com:465).
MAIL_FROM=CodeDev <dev@codedev.local>
MAIL_PASSWORD=
# Optional, another SMTP provider instead of Gmail.
# MAIL_HOST=
# MAIL_PORT=465
EMAIL_VERIFY_TTL_SECONDS=86400
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_ID=
GOOGLE_SECRET=

# --- Database (local Postgres in development, Neon in production)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/codedev
DATABASE_URL_UNPOOLED=
# Pool per app instance (lib/db.js; default 3 on Vercel, 10 elsewhere). Serverless: also use the
# Neon -pooler host in DATABASE_URL.
DB_POOL_MAX=
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_IN_TX_TIMEOUT_MS=15000

# --- Redis cache / rate limits
REDIS_URL=redis://localhost:6379
REDIS_TOKEN=

# --- Object storage (MinIO in development, S3-compatible in production)
STORAGE_PROVIDER=minio
S3_BUCKET=public
S3_PRIVATE_BUCKET=private
S3_MEDIA_BUCKET=media
S3_CHAT_BUCKET=codedev-chat-media
# Chat images in production only (Upstash Blob); in development they go to the MinIO chat bucket
UPSTASH_BLOB_TOKEN=
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Code runner (codedev_sandbox, docs/sandbox.md)
# Set CODE_RUNNER_URL to grade coding submissions on the server (outputs reported by the browser
# are then ignored). `npm run services:up` starts the sandbox with a loopback gateway on :4100.
CODE_RUNNER_URL=http://127.0.0.1:4100
# Shared secret (16+ characters) between the app and the sandbox, e.g. `openssl rand -hex 24`.
CODE_RUNNER_TOKEN=
CODE_RUNNER_CONCURRENCY=2
# Production on Vercel: grade on Vercel Sandbox instead (lib/challenges/vercelRunner.js, docs/sandbox.md).
# CODE_RUNNER_PROVIDER=vercel
# CODE_RUNNER_SANDBOX=codedev-runner-v2
# CODE_RUNNER_IMAGE=codedev-runner:v2
# CODE_RUNNER_VCPUS=2
# Microvms per sandbox name (`<name>-0` .. `<name>-N-1`); each takes CODE_RUNNER_VCPUS jobs at a time.
# CODE_RUNNER_POOL_SIZE=1

# --- Background jobs (Inngest, docs/queue-execution-plan.md)
# Unset: background work runs inline (outbox right after commit, code runs inside the request).
# Production: both keys from the Inngest dashboard. Local: INNGEST_DEV=1 with the `inngest` dev server
# from `npm run services:up` (compose.yml, dashboard http://127.0.0.1:8288).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# INNGEST_DEV=1
# Rollback switches while Inngest is configured: OUTBOX_DELIVERY=inline, CODE_EXEC_MODE=sync.
# Days a hidden blog post is kept (positive integer). Lowering it deletes older hidden posts at the next 03:15 UTC run; set the same value for the app and Inngest.
BLOG_HIDDEN_PURGE_DAYS=30

# --- Realtime (Pusher)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# --- Web push (Pusher Beams, Keys tab of the instance). Blank = web push off.
# Both instance ids hold the Instance ID. BEAMS_SECRET_KEY is the Primary key: server only,
# never NEXT_PUBLIC_, never committed.
BEAMS_INSTANCE_ID=
NEXT_PUBLIC_BEAMS_INSTANCE_ID=
BEAMS_SECRET_KEY=

# --- Content: lesson bodies come from one store per environment (docs/payload-cms.md)
# Blank = by environment: production/staging read Sanity, everything else the local Payload CMS.
# Set to sanity or payload to override.
LESSON_CONTENT_SOURCE=
# Sanity: the lesson store of production and staging.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=
# Write token: only needed by content/tools/push-lesson.mjs
SANITY_API_TOKEN=
# Signs the lesson webhook (POST /api/webhooks/sanity) that drops cached lesson bodies on publish.
SANITY_WEBHOOK_SECRET=
# Local Payload CMS: the lesson store of local development (npm run cms:up, then npm run cms:sync).
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PAYLOAD_SECRET=
CMS_DB_PASSWORD=
CMS_ADMIN_EMAIL=cms-admin@codedev.test
CMS_ADMIN_PASSWORD=
CMS_API_KEY=
PAYLOAD_URL=http://127.0.0.1:3010
# Same value as CMS_API_KEY.
PAYLOAD_API_KEY=
# Cloudinary: PRODUCTION ONLY (APP_ENV=production). Every other environment stores uploads in the
# Payload CMS above; CLOUDINARY_* is ignored there. Used by services/media.service.js and
# content/tools/upload-media.mjs (production target).
# Uploads go to <CLOUDINARY_ROOT_FOLDER>/users/... and .../courses/... (the account serves production only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=codedev
