# Copy to .env.local for development. Real values live in .env.local / .env / Vercel project
# settings and are never committed. See docs/environments.md for what each environment uses.

# --- App
APP_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000/api
MACHINE_ID=1

# --- Auth (NextAuth + session tokens)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_ALLOWED_ORIGINS=
AUTH_CRON_SECRET=
REFRESH_TOKEN_HASH_SECRET=
REFRESH_TOKEN_RECOVERY_KEY=
# Email (lib/mailConfig.mjs). Check any env file with `npm run mail:test -- --env <file> --to <you>`.
# MAIL_PASSWORD empty: development sends to Mailpit (compose.yml, inbox http://127.0.0.1:8025).
# Production: MAIL_FROM = the Gmail address, MAIL_PASSWORD = its App Password (smtp.gmail.com:465).
MAIL_FROM=CodeDev <dev@codedev.local>
MAIL_PASSWORD=
# Optional, another SMTP provider instead of Gmail (e.g. smtp.resend.com once there is a domain).
# MAIL_HOST=
# MAIL_PORT=465
EMAIL_VERIFY_TTL_SECONDS=86400
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_ID=
GOOGLE_SECRET=

# --- Database (local Postgres in development, Neon in production)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/codedev
DATABASE_URL_UNPOOLED=

# --- Redis cache / rate limits
REDIS_URL=redis://localhost:6379
REDIS_TOKEN=

# --- Object storage (MinIO in development, S3-compatible in production)
STORAGE_PROVIDER=minio
S3_BUCKET=public
S3_PRIVATE_BUCKET=private
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Code runner (codedev_sandbox, docs/sandbox.md)
# Set CODE_RUNNER_URL to grade coding submissions on the server (outputs reported by the browser
# are then ignored). `npm run services:up` starts the sandbox with a loopback gateway on :4100.
CODE_RUNNER_URL=http://127.0.0.1:4100
# Shared secret (16+ characters) between the app and the sandbox, e.g. `openssl rand -hex 24`.
CODE_RUNNER_TOKEN=
CODE_RUNNER_CONCURRENCY=2
# Production on Vercel: grade on Vercel Sandbox instead (lib/challenges/vercelRunner.js, docs/sandbox.md).
# CODE_RUNNER_PROVIDER=vercel
# CODE_RUNNER_SANDBOX=codedev-runner-v2
# CODE_RUNNER_IMAGE=codedev-runner:v2
# CODE_RUNNER_VCPUS=2

# --- Realtime (Pusher)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# --- Content (Sanity lessons, Cloudinary lesson images)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=
# Write token: only needed by content/tools/push-lesson.mjs
SANITY_API_TOKEN=
# Cloudinary: avatar uploads (services/media.service.js) and content/tools/upload-images.mjs.
# Uploads go to <CLOUDINARY_ROOT_FOLDER>/<APP_ENV>/..., so environments sharing one cloud stay apart.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=codedev
