# Load-test environment (compose.loadtest.yml). Copy to .env.loadtest (git-ignored) and fill the blanks.
# Used twice: compose reads it through --env-file, and the app container loads it as its env file.
# --- Compose wiring
# Makes compose.yml load this file as the app's runtime env file.
CODEDEV_ENV_FILE=.env.loadtest
# development, not staging: lib/envCheck.mjs makes staging fatal with MinIO storage and an http NEXTAUTH_URL.
APP_ENV=development
# Serve lessons from Sanity even though APP_ENV is development.
LESSON_CONTENT_SOURCE=sanity
# Host port of postgres-load; change it (and LOADTEST_DATABASE_URL) when 5433 is taken.
POSTGRES_LOAD_PORT=5433
# Password of the postgres-load superuser (any random value).
POSTGRES_LOAD_PASSWORD=
# Shared secret between the app and the sandbox, 16+ characters.
CODE_RUNNER_TOKEN=
CODE_RUNNER_CONCURRENCY=2
# Grafana admin login for the monitoring profile.
GRAFANA_ADMIN_PASSWORD=
# Grafana reads the database as grafana_ro; leave blank unless that role exists in postgres-load.
GRAFANA_PG_PASSWORD=
# compose.yml interpolates the CMS service too, even though load runs never start it: any random value.
PAYLOAD_SECRET=
CMS_DB_PASSWORD=
# --- Load-test database
# App container: the per-run database on postgres-load (same password as POSTGRES_LOAD_PASSWORD).
DATABASE_URL=postgres://postgres:<pw>@postgres-load:5432/loadtest_run
# Scripts on the host: the base database that migrations and the seed dump are built from.
LOADTEST_DATABASE_URL=postgres://postgres:<pw>@localhost:5433/loadtest_base
# Sign-in password given to every seeded load-test user.
LOADTEST_PASSWORD=
# Pool per app instance.
DB_POOL_MAX=
# --- App
# Host port of the app container; change it when 3000 is taken (then pass --base http://localhost:<port> to the load scripts).
APP_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
# Origin the app signs callbacks for.
NEXTAUTH_URL=http://localhost:3000
# Session signing key, 32+ random characters.
NEXTAUTH_SECRET=
# Refresh-token hashing key, 32+ random characters.
REFRESH_TOKEN_HASH_SECRET=
# Key for the encrypted admin TOTP secrets, 32+ random characters (required when APP_ENV=staging).
ADMIN_MFA_KEY=
# Bearer token for the full GET /api/health report.
HEALTH_TOKEN=
# OAuth sign-in is not exercised by load runs.
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_ID=
GOOGLE_SECRET=
# Mail goes to Mailpit/none during a run.
MAIL_FROM=CodeDev <dev@codedev.local>
# --- Object storage (MinIO)
STORAGE_PROVIDER=minio
# MinIO endpoint as the app container sees it.
MINIO_ENDPOINT=http://minio:9000
# MinIO login, same as .env.local.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# --- Content (Sanity serves lessons in staging)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=
# --- Realtime and push: off during load runs
# Pusher server credentials, blank = realtime off.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
# Pusher browser credentials, blank = realtime off.
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
# Pusher Beams web push, blank = off.
BEAMS_INSTANCE_ID=
NEXT_PUBLIC_BEAMS_INSTANCE_ID=
BEAMS_SECRET_KEY=
# Cloudinary is production-only, blank here.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
