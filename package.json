{
  "name": "codedev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rmdir /s /q .next && rmdir /s /q node_modules && del package-lock.json",
    "services:up": "docker compose --env-file .env.local --profile dev up -d --build",
    "services:down": "docker compose --env-file .env.local --profile dev down",
    "docker:app": "docker compose --env-file .env.production --profile app up -d --build",
    "storage:sync": "node scripts/storage-sync.mjs",
    "storage:init": "node scripts/storage-sync.mjs --init",
    "db:migrate": "node db/tools/migrate.mjs",
    "db:migrate:prod": "node db/tools/migrate.mjs --env .env.production",
    "db:compare": "node db/tools/compare-schema.mjs",
    "db:export": "node db/tools/export-schema.mjs",
    "dlq": "node scripts/dlq.mjs",
    "mail:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/mail-test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@neondatabase/serverless": "^1.2.0",
    "@portabletext/react": "^8.0.1",
    "@pusher/push-notifications-web": "^1.1.0",
    "@react-email/components": "^1.0.12",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.20.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@upstash/redis": "^1.40.0",
    "@vercel/postgres": "^0.10.0",
    "@vercel/sandbox": "^3.9.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "cookie": "^2.0.1",
    "crypto": "^1.0.1",
    "dotenv": "^18.0.9",
    "eslint-config-next": "^16.4.3",
    "inngest": "^4.24.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "lodash": "^4.18.1",
    "next": "^16.4.3",
    "next-auth": "^4.24.15",
    "next-sanity": "^13.4.0",
    "nodemailer": "^10.2.1",
    "path-to-regexp": "^9.0.0",
    "pg": "^8.23.1",
    "postcss": "^8.5.31",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "qs": "^6.16.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-syntax-highlighter": "^16.1.2",
    "sanity": "^6.20.0",
    "sonner": "^2.0.8",
    "styled-components": "^6.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "baseline-browser-mapping": "^2.11.33",
    "eslint": "^10.13.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    }
  }
}
